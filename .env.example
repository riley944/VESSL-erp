# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL, used by the browser and the API routes.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key, used by the browser client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Resend API key, used by the RFQ send route, the task emails and the weekly digests.
RESEND_API_KEY=
# Supabase service-role key, used only by the scheduled RFQ digest. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the Vercel cron sends to the RFQ digest route.
CRON_SECRET=
# Optional, leave unset. Port the predev guard checks; `npm run dev` is fixed to 3000.
PORT=
# Quote form "Import from PDF" (factory quote PDFs): shown, and /api/quotes/extract
# answers, only when this is exactly 1. Unset or anything else hides it. Read at
# build time, so a deploy needs a rebuild after changing it. The sales order
# "Import from PO PDF" is not behind this flag.
NEXT_PUBLIC_QUOTE_PDF_IMPORT=
